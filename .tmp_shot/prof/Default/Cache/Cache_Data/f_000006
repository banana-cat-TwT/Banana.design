        }
        .brand h1 { font-size: 1.05rem; letter-spacing: 2px; font-weight: 700; }
        .brand span {
            display: block;
            font-size: 0.68rem;
            letter-spacing: 4px;
            color: var(--ink-soft);
            margin-top: 4px;
        }

        /* 右上角操作提示 */
        .guide {
            position: fixed;
            top: 22px;
            right: 24px;
            z-index: 12;
            padding: 12px 15px;
            border-radius: 15px;
            background: var(--glass);
            backdrop-filter: blur(12px) saturate(1.1);
            -webkit-backdrop-filter: blur(12px) saturate(1.1);
            border: 1px solid var(--glass-line);
            box-shadow: var(--shadow);
            font-size: 0.72rem;
            line-height: 1.95;
            color: var(--ink-soft);
            letter-spacing: 0.4px;
            pointer-events: none;
        }
        .guide b { color: var(--ink); font-weight: 600; }

        /* 左侧工具栏 */
        .toolbar {
            position: fixed;
            left: 24px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 16;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 10px 8px;
            border-radius: 19px;
            background: var(--glass);
            backdrop-filter: blur(14px) saturate(1.1);
            -webkit-backdrop-filter: blur(14px) saturate(1.1);
            border: 1px solid var(--glass-line);
            box-shadow: var(--shadow);
        }
        .tool {
            position: relative;
            width: 38px;
            height: 38px;
            border: none;
            border-radius: 12px;
            background: transparent;
            color: var(--ink-soft);
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: background .18s, color .18s, transform .18s;
        }
        .tool svg {
            width: 19px; height: 19px;
            fill: none; stroke: currentColor;
            stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round;
        }
        .tool:hover { background: rgba(240, 176, 120, 0.2); color: var(--ink); }
        .tool.active {
            background: linear-gradient(135deg, #F3BB84, #E08B5A);
            color: #fff;
            box-shadow: 0 6px 15px rgba(224, 139, 90, 0.38);
        }
        .tool::after {
            content: attr(data-tip);
            position: absolute;
            left: calc(100% + 12px);
            top: 50%;
            transform: translateY(-50%) translateX(-4px);
            white-space: nowrap;
            font-size: 0.7rem;
            letter-spacing: 1px;
            padding: 5px 9px;
            border-radius: 8px;
            background: rgba(74, 63, 51, 0.9);
            color: #fff;
            opacity: 0;
            pointer-events: none;
            transition: opacity .18s, transform .18s;
        }
        .tool:hover::after { opacity: 1; transform: translateY(-50%) translateX(0); }

        .tool-hint {
            position: fixed;
            left: 84px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 16;
            padding: 8px 13px;
            border-radius: 12px;
            background: rgba(74, 63, 51, 0.88);
            color: #fff;
            font-size: 0.74rem;
            letter-spacing: 1px;
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: opacity .5s;
        }
        .tool-hint.show { opacity: 1; }
        .tool-hint::before {
            content: '';
            position: absolute;
            left: -5px;
            top: 50%;
            margin-top: -5px;
            width: 9px; height: 9px;
            background: inherit;
            transform: rotate(45deg);
        }

        /* 中央密码卡 */
        .gate-wrap {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 20;
            pointer-events: none;
        }
        .gate-card {
            pointer-events: auto;
            width: min(348px, 86vw);
            padding: 1.55rem 1.75rem 1.5rem;
            text-align: center;
            background: rgba(255, 253, 248, 0.75);
            backdrop-filter: blur(16px) saturate(1.15);
            -webkit-backdrop-filter: blur(16px) saturate(1.15);
            border: 1px solid rgba(255, 255, 255, 0.72);
            border-radius: 22px;
            box-shadow: 0 22px 58px rgba(90, 74, 44, 0.2), inset 0 1px 0 rgba(255,255,255,0.65);
        }
        .card-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.62rem;
            letter-spacing: 2.2px;
            color: var(--ink-soft);
            padding: 4px 10px;
            border-radius: 999px;
            background: rgba(240, 176, 120, 0.16);
            border: 1px solid rgba(232, 168, 124, 0.35);
            margin-bottom: 0.85rem;
