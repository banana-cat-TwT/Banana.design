    <style>
        :root {
            --sand: #E6D3B3;
            --sand-dark: #D9C29B;
            --grass: #9BC99B;
            --grass-deep: #7FB87F;
            --water: #8FC8E8;
            --roof: #E8A87C;
            --roof-deep: #D98E63;
            --cream: #F7EFE3;
            --ink: #4A3F33;
            --ink-soft: #8A7A68;
            --glass: rgba(255, 253, 248, 0.74);
            --glass-line: rgba(255, 255, 255, 0.82);
            --shadow: 0 14px 34px rgba(90, 74, 44, 0.16);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            height: 100%;
            overflow: hidden;
            font-family: 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background:
                radial-gradient(120% 90% at 50% 0%, #FFFBF2 0%, rgba(255,251,242,0) 62%),
                linear-gradient(180deg, #FBF4E8 0%, #EAF2EE 58%, #DDE8E2 100%);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
            -webkit-tap-highlight-color: transparent;
        }

        #scene-canvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            z-index: 0;
            cursor: grab;
            touch-action: none;
        }
        #scene-canvas.grabbing { cursor: grabbing; }

        .vignette {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background: radial-gradient(120% 95% at 50% 46%, rgba(255,255,255,0) 52%, rgba(120, 104, 78, 0.16) 100%);
