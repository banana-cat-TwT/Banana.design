        .gate-error { color: #D4722E; font-size: 0.8rem; line-height: 1.4; min-height: 1.15em; margin-top: 0.6rem; }
        .gate-note { margin-top: 0.7rem; color: var(--ink-soft); font-size: 0.71rem; line-height: 1.7; }

        /* 3D 锚点标签（JS 投影定位） */
        .pill {
            position: fixed;
            left: 0;
            top: 0;
            z-index: 15;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 13px 8px 9px;
            border: 1px solid rgba(255, 255, 255, 0.85);
            border-radius: 15px;
            background: rgba(255, 253, 248, 0.84);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            color: var(--ink);
            box-shadow: 0 10px 26px rgba(90, 74, 44, 0.15), inset 0 1px 0 rgba(255,255,255,0.7);
            cursor: pointer;
            will-change: transform;
            transition: background .2s, box-shadow .2s, opacity .35s;
        }
        .pill::after {
            content: '';
            position: absolute;
            left: 50%;
            bottom: -5px;
            margin-left: -5px;
            width: 9px; height: 9px;
            background: inherit;
            border-right: 1px solid rgba(255, 255, 255, 0.85);
            border-bottom: 1px solid rgba(255, 255, 255, 0.85);
            transform: rotate(45deg);
            border-bottom-right-radius: 2px;
        }
        .pill .n {
            width: 28px; height: 28px;
            border-radius: 9px;
            background: linear-gradient(135deg, #F3BB84, #E08B5A);
            color: #fff;
            font-size: 0.86rem;
            font-weight: 700;
            display: flex; align-items: center; justify-content: center;
            flex: 0 0 auto;
            box-shadow: 0 3px 8px rgba(224, 139, 90, 0.35);
            transition: transform .2s;
        }
        .pill .t { display: flex; flex-direction: column; line-height: 1.22; text-align: left; }
        .pill .t b { font-size: 0.82rem; font-weight: 700; }
        .pill .t span { font-size: 0.63rem; letter-spacing: 1.4px; color: var(--ink-soft); }
        .pill:hover { background: #fffdf8; box-shadow: 0 14px 30px rgba(90, 74, 44, 0.22); }
        .pill:hover .n { transform: scale(1.07) rotate(-4deg); }
        .pill.on {
            background: #fffdf8;
            border-color: rgba(232, 168, 124, 0.85);
            box-shadow: 0 14px 34px rgba(224, 139, 90, 0.3), 0 0 0 3px rgba(232, 168, 124, 0.16);
        }

        /* 底部时间轴 */
        .stepper {
            position: fixed;
            left: 50%;
            bottom: 20px;
            transform: translateX(-50%) translateY(8px);
            z-index: 16;
            width: min(880px, calc(100vw - 120px));
            padding: 9px 20px 13px;
            border-radius: 17px;
            background: var(--glass);
            backdrop-filter: blur(14px) saturate(1.1);
            -webkit-backdrop-filter: blur(14px) saturate(1.1);
            border: 1px solid var(--glass-line);
            box-shadow: var(--shadow);
            opacity: 0;
            transition: opacity .5s ease, transform .5s ease;
        }
        .stepper.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        .stepper-head {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.66rem;
            letter-spacing: 0.8px;
            color: var(--ink-soft);
            margin-bottom: 9px;
            padding-left: 2px;
        }
        .stepper-head i {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: #9ECFA0;
            box-shadow: 0 0 0 3px rgba(158, 207, 160, 0.25);
        }
        .stepper-head b { color: var(--ink); font-weight: 600; }
        .stepper-head .sep { opacity: .45; }

        .steps { position: relative; display: flex; align-items: flex-start; }
        .step {
            position: relative;
            flex: 0 0 auto;
            width: 62px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--ink-soft);
            font-family: inherit;
            padding: 0;
        }
        .step i {
            width: 24px; height: 24px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 0.68rem;
            font-style: normal;
            font-weight: 700;
            background: rgba(255, 255, 255, 0.7);
            border: 1px dashed rgba(160, 142, 118, 0.6);
            color: var(--ink-soft);
            transition: all .25s;
        }
        .step em {
            font-style: normal;
            font-size: 0.66rem;
            letter-spacing: 0.6px;
            white-space: nowrap;
            transition: color .25s;
        }
        .step:hover i { border-color: var(--roof-deep); color: var(--roof-deep); }
        .step:hover em { color: var(--ink); }
        .step.on i {
            background: linear-gradient(135deg, #F3BB84, #E08B5A);
            border: 1px solid transparent;
            color: #fff;
            box-shadow: 0 4px 12px rgba(224, 139, 90, 0.42);
            transform: scale(1.08);
        }
        .step.on em { color: var(--ink); font-weight: 600; }

        .step-line {
            flex: 1 1 auto;
            height: 1px;
            margin-top: 12px;
            border-top: 1px dashed rgba(160, 142, 118, 0.45);
            min-width: 8px;
        }

        .pencil {
            position: absolute;
            bottom: -9px;
            z-index: 3;
            pointer-events: none;
            left: 0;
            width: 15px;
            height: 15px;
            color: var(--roof-deep);
            transform: translateX(-50%) rotate(-14deg);
            transition: left .45s cubic-bezier(.4, 0, .2, 1);
            opacity: 0;
        }
        .pencil.show { opacity: 1; }
        .pencil svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

        /* 入场动画 */
        .gate-card, .brand, .guide, .toolbar {
            opacity: 0;
            animation: fadeIn .9s ease forwards;
        }
        .brand { animation-delay: .1s; }
        .guide { animation-delay: .25s; }
        .toolbar { animation-delay: .35s; }
        .gate-card { animation-delay: .3s; }
        @keyframes fadeIn { to { opacity: 1; } }

        .gate-card.leaving {
            transition: opacity .45s ease, transform .45s ease;
            opacity: 0;
            transform: scale(.9) translateY(-8px);
        }
        .pill.hide, .brand.hide, .guide.hide, .toolbar.hide, .stepper.hide, .tool-hint.hide {
            transition: opacity .45s ease;
            opacity: 0;
            pointer-events: none;
        }

        @media (max-width: 860px) {
            .brand { top: 16px; left: 18px; }
            .brand h1 { font-size: 0.95rem; }
            .guide { display: none; }
            .toolbar { left: 12px; padding: 8px 6px; gap: 4px; }
            .tool { width: 32px; height: 32px; border-radius: 10px; }
            .tool svg { width: 16px; height: 16px; }
            .tool::after { display: none; }
            .tool-hint { display: none; }
            .pill { padding: 6px 10px 6px 7px; gap: 7px; border-radius: 12px; }
            .pill .n { width: 22px; height: 22px; border-radius: 7px; font-size: 0.72rem; }
            .pill .t b { font-size: 0.73rem; }
            .pill .t span { font-size: 0.56rem; letter-spacing: 1px; }
            .stepper { width: calc(100vw - 88px); bottom: 12px; padding: 7px 12px 11px; }
            .stepper-head { display: none; }
            .step { width: 46px; }
            .step i { width: 20px; height: 20px; font-size: 0.6rem; }
            .step em { font-size: 0.56rem; letter-spacing: 0; }
            .step-line { margin-top: 10px; }
            .pencil { display: none; }
            .gate-card { padding: 1.35rem 1.4rem 1.3rem; }
        }

        @media (max-height: 620px) {
            .stepper { display: none; }
        }
    </style>

