            border-radius: 50%;
            background: var(--roof-deep);
            animation: blink 2s ease-in-out infinite;
        }
        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }

        .gate-card h2 { font-size: 1.28rem; letter-spacing: 1px; margin-bottom: 0.32rem; }
        .gate-desc { color: var(--ink-soft); font-size: 0.84rem; margin-bottom: 1.15rem; }
        .gate-input {
            width: 100%;
            text-align: center;
            font-size: 1.7rem;
            letter-spacing: 0.52em;
            padding: 0.55rem 0 0.55rem 0.52em;
            border: 1px solid rgba(200, 180, 150, 0.7);
            border-radius: 13px;
            outline: none;
            color: var(--ink);
            background: rgba(255, 251, 243, 0.88);
            transition: border-color .2s, box-shadow .2s;
        }
        .gate-input:focus {
            border-color: var(--roof);
            box-shadow: 0 0 0 3px rgba(232, 168, 124, 0.22);
        }
        .gate-btn {
            margin-top: 0.95rem;
            width: 100%;
            padding: 0.7rem;
            background: linear-gradient(135deg, #F3BB84, #E08B5A);
            color: #fff;
            border: none;
            border-radius: 13px;
            font-size: 0.98rem;
            font-weight: 600;
            letter-spacing: 3px;
            cursor: pointer;
            transition: transform .15s, box-shadow .2s, filter .2s;
            box-shadow: 0 8px 18px rgba(224, 139, 90, 0.34);
        }
        .gate-btn:hover { transform: translateY(-1px); box-shadow: 0 11px 24px rgba(224, 139, 90, 0.44); filter: brightness(1.03); }
